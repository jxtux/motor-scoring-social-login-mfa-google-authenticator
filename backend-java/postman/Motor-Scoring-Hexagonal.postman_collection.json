  },
  "item": [
    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Servicio UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - RF04 Registrar solicitud",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/solicitudes-credito",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "solicitudes-credito"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identificadorExterno\": \"{{identificadorExterno}}\",\n  \"solicitante\": {\n    \"tipoDocumento\": \"DNI\",\n    \"numeroDocumento\": \"{{numeroDocumento}}\",\n    \"nombresRazonSocial\": \"Persona de prueba\",\n    \"ingresosMensuales\": 5500,\n    \"gastosMensuales\": 1800,\n    \"obligacionesFinancieras\": 700,\n    \"antiguedadLaboralNegocio\": 36,\n    \"numeroObligacionesActivas\": 2,\n    \"puntajeHistorialPagos\": 85,\n    \"alertasMora\": 0\n  },\n  \"codigoProducto\": \"PRESTAMO_PERSONAL\",\n  \"montoSolicitado\": 15000,\n  \"plazoSolicitado\": 24,\n  \"moneda\": \"PEN\",\n  \"finalidadCredito\": \"Consumo\",\n  \"canalOrigen\": \"POSTMAN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = Date.now();",
              "pm.collectionVariables.set('identificadorExterno', `POSTMAN-${now}`);",
              "pm.collectionVariables.set('numeroDocumento', String(10000000 + (now % 89999999)).slice(0, 8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Estado REGISTRADA', () => pm.expect(json.estado).to.eql('REGISTRADA'));",
              "pm.collectionVariables.set('idSolicitud', json.idSolicitud);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - RF05/RF06 Evaluar solicitud",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/solicitudes-credito/{{idSolicitud}}/evaluar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "solicitudes-credito",
            "{{idSolicitud}}",
            "evaluar"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Puntaje 989', () => pm.expect(json.puntajeTotal).to.eql(989));",
              "pm.test('Resultado PREAPROBADA', () => pm.expect(json.resultado).to.eql('PREAPROBADA'));",
              "pm.test('Versión 1.1.0', () => pm.expect(json.versionModelo).to.eql('1.1.0'));",
              "pm.test('Nueve factores', () => pm.expect(json.factores).to.have.lengthOf(9));"
            ]
          }
        }
      ]
    },
