{
  "info": {
    "_postman_id": "50e3b8cb-b329-4bd6-b686-3f246f50d205",
    "name": "Motor Scoring Crediticio Hexagonal",
    "description": "Mismo contrato para MongoDB (predeterminado) y H2. RF04, RF05 y RF06.",
