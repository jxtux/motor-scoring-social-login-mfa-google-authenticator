# PostgreSQL
POSTGRES_DB=motor_scoring
POSTGRES_USER=motor_scoring
POSTGRES_PASSWORD=motor_scoring

# Password used by the local development JKS/PKCS12 files.
DEV_CERT_PASSWORD=changeit

# Kafka KRaft / SCRAM lab credentials. Change them for your local environment.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_ADMIN_PASSWORD=AdminKafka2026
KAFKA_BROKER_PASSWORD=BrokerKafka2026
KAFKA_API_PASSWORD=ApiKafka2026
KAFKA_OUTBOX_PASSWORD=OutboxKafka2026
KAFKA_PAYMENT_PASSWORD=PaymentKafka2026
KAFKA_SCORING_PASSWORD=ScoringKafka2026
KAFKA_DELIVERY_PASSWORD=DeliveryKafka2026
KAFKA_DLT_PASSWORD=DltKafka2026
KAFKA_UI_PASSWORD=UiKafka2026

# Gmail SMTP sender account. This account is static backend configuration.
# GMAIL_APP_PASSWORD must be a Google App Password, never the normal Gmail password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# IAM / Seguridad (desarrollo)
# -----------------------------------------------------------------------------
# El script scripts/generate-dev-certs.sh genera por defecto:
# - backend-java/docker/certs/iam-private.pem
# - backend-java/docker/certs/iam-public.pem
# - backend-java/docker/certs/iam-totp-aes.key
# - backend-java/docker/certs/iam-verification-pepper.txt
# Por eso no es necesario pegar secretos IAM aquí para la demo local.
# Puedes sobrescribirlos si lo necesitas:
IAM_RSA_PRIVATE_KEY=
IAM_RSA_PUBLIC_KEY=
IAM_TOTP_AES_KEY=
IAM_VERIFICATION_PEPPER=
IAM_MAIL_FROM=

# Angular corre en HTTP y la API en HTTPS. Para la cookie HttpOnly de refresh
# en esta demo cross-scheme usamos SameSite=None + Secure. En producción, si
# frontend/backend son same-site HTTPS, endurecer a Lax/Strict según el diseño.
IAM_FRONTEND_SOCIAL_CALLBACK=http://localhost:4200/auth/social-callback
IAM_REFRESH_COOKIE_SECURE=true
IAM_REFRESH_COOKIE_SAME_SITE=None

# Google OAuth 2.0 + OpenID Connect
# Redirect URI a registrar:
# https://localhost:8443/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Login Kit Web / OAuth 2.0
# Para Web el redirect debe cumplir los requisitos HTTPS del proveedor.
# Si usas un túnel HTTPS, registra y coloca aquí EXACTAMENTE su callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://localhost:8443/api/v1/auth/social/tiktok/callback
